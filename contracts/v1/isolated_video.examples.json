{
  "contract": "vibe-director.isolated-video",
  "version": "1.0.0-proposed",
  "status": "PROPOSED_ADAPTER_EXAMPLES_NOT_LIVE_ENDPOINTS",
  "notes": {
    "workflow_id": "minimax_h3_t2v_local_v1",
    "workflow_version": 1,
    "readiness": "Use existing production_t2v_capability.t2v_capability(): STORY_BUILDER_ENABLE_H3_T2V, exact graph/model files, graph node contract, live Comfy /object_info node list, and intact hash-verified output in output/disposable-h3-t2v-smoke/manifest.json. COMFYUI_ROOT selects model root; COMFYUI_URL defaults to http://127.0.0.1:3008.",
    "settings_basis": "Local T2V compiler accepts 5..10 seconds, 16:9 and resolution presets 0.98→1344×768 and 0.4→864×480. ReferencePlan defaults to resolution 0.98, steps 20, seed 1. T2V compiler writes steps/seed without bounds checks. This first adapter fixes steps=20 and seed=1; editable settings are deferred pending a separately reviewed T2V capability contract.",
    "duration": "duration_seconds is requested. Compiled frame_count is rounded upward to 17n+5 at 24 fps; previews report predicted_duration_seconds. A live output probe must establish any actual realized duration.",
    "prompt_limit": "Product requirement is strictly below 7000 MiniMax characters; implement the adapter limit. Never truncate silently.",
    "identity": "job_id is application durable identity; prompt_id is exact reserved ComfyUI identity; output asset_id is stable library identity.",
    "reconnect": "GET/reconcile only; never submit automatically. Unknown remote outcome is not safe to retry until exact prompt_id is reconciled.",
    "workflow_path": "Proposed target is backend/story_builder/workflows/api/minimax_h3_t2v_api.json, preserving compiler PROJECT_ROOT/workflows/api path.",
    "runtime_placeholders": "Only runtime-generated IDs and content hashes may be symbolic; all request parameters and compiler-derived outputs in examples are concrete.",
    "fixture_mode": "All examples are mock contract fixtures. Runtime-generated IDs/hashes are symbolic; the completed sample output is explicitly mock and is not evidence of an actual asset or render.",
    "retake_retention": "The keep/delete decision applies to the previous generated video candidate only. Deleting a candidate must not delete shared/referenced source assets; retain any asset still referenced by another take and report deletion disposition. Retake copies every original setting/reference and preserves seed unless the user explicitly edits it."
  },
