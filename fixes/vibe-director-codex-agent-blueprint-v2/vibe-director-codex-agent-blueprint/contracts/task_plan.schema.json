{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.vibe-director/contracts/film-task-plan-v1.json",
  "title": "Proposed TaskPlan V1 (not yet backend schema)",
  "type": "object",
  "required": [
    "plan_id",
    "project_id",
    "revision",
    "status",
    "goal",
    "tasks"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "planning",
        "awaiting_approval",
        "approved",
        "running",
        "blocked",
        "paused",
        "verifying",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "goal": {
      "type": "string"
    },
    "estimated_runtime_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "tool_id",
          "depends_on",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "tool_id": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "planned",
              "waiting_approval",
              "ready",
              "running",
              "blocked",
              "verifying",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}